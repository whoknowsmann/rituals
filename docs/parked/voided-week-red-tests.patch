diff --git a/src/features/rituals/solo/lifecycle/soloRitualModel.test.ts b/src/features/rituals/solo/lifecycle/soloRitualModel.test.ts
index ae648f9..a63f2a1 100644
--- a/src/features/rituals/solo/lifecycle/soloRitualModel.test.ts
+++ b/src/features/rituals/solo/lifecycle/soloRitualModel.test.ts
@@ -87,4 +87,32 @@ describe('soloRitualModel', () => {
       expect(soloRitualModel(bundle({}, null), 50, me).lastClosedEventIndex).toBeNull()
     })
   })
+
+  describe('a week voided without a verdict (witness questioned or never answered)', () => {
+    const voided = (voidReason: string, claimStatus: 'Pending' | 'Questioned') => bundle(
+      { witness, additionalConfirmationThreshold: 1, currentEventIndex: 1 },
+      null,
+      [],
+    )
+    const withHistory = (voidReason: string, claimStatus: 'Pending' | 'Questioned') => ({
+      ...voided(voidReason, claimStatus),
+      history: [{ ritual: voided(voidReason, claimStatus).ritual, event: event({ status: 'Voided', voidReason, eventIndex: 0 }), claims: [claim(claimStatus)] }],
+    }) as unknown as SoloRitualBundle
+
+    it('says the stake came back instead of silently moving on', () => {
+      const model = soloRitualModel(withHistory('UnresolvedClaims', 'Questioned'), 350, me)
+      expect(model.state).toBe('returned')
+      expect(model.message).toContain('came back')
+    })
+
+    it('marks voided and skipped weeks as rest, never as a check-in', () => {
+      expect(soloRitualModel(withHistory('UnresolvedClaims', 'Pending'), 350, me).weekCells[0]).toBe('rest')
+      expect(soloRitualModel(withHistory('DeclaredSkip', 'Pending'), 350, me).weekCells[0]).toBe('rest')
+    })
+
+    it('never offers to settle a week that is already voided', () => {
+      const current = bundle({ witness, additionalConfirmationThreshold: 1 }, event({ status: 'Voided', voidReason: 'UnresolvedClaims' }), [claim('Questioned')])
+      expect(soloRitualModel(current, 350, me).state).toBe('returned')
+    })
+  })
 })
