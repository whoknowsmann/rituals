{
  "expo": {
    "name": "Rituals",
    "slug": "rituals",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0C0A09",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0C0A09"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.whoknowsmann.rituals"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0C0A09"
      },
      "package": "com.whoknowsmann.rituals"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "owner": "argussmithson",
    "extra": {
      "eas": {
        "projectId": "e9c85975-2a4d-4597-8d81-dd7e17921cc4"
      }
    },
    "plugins": [
      "expo-font",
      "expo-notifications"
    ]
  }
}
